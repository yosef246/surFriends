NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Web Push (VAPID). Raw P-256 keypair, base64url (65-byte public, 32-byte private), as the `web-push` lib expects.
# Generate: pnpm dlx web-push generate-vapid-keys   (the private key never goes to the browser)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY; inlined into the browser bundle at build time (needed to subscribe).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact for the push services: a https:// URL or mailto: address.
VAPID_SUBJECT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <value>").
# Generate: openssl rand -hex 32   |   PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
CRON_SECRET=
